# Copie este arquivo para backend/.env e altere apenas os valores locais.
# Não versione o arquivo backend/.env.
DATABASE_URL="mysql://solutec_app:troque_esta_senha@localhost:3306/solutec"
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
BCRYPT_ROUNDS=12

# Autenticação JWT (HS256). JWT_SECRET é obrigatório e precisa de no mínimo 32 caracteres.
# Gere um valor próprio, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-local-com-no-minimo-32-caracteres"
# Validade do token: segundos ("3600") ou com unidade s, m, h, d ("2h", "30m", "7d").
JWT_EXPIRES_IN="2h"

# Opcional: copie a linha abaixo para frontend/.env se a API usar outro endereço.
VITE_API_URL="http://localhost:3000/api"
