meta {
  name: Produtos — listar paginado
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/produtos?page=1&limit=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("retorna HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("respeita o limit", function () {
    expect(res.getBody().data.length).to.be.at.most(5);
    expect(res.getBody().meta.limit).to.equal(5);
  });
}
