meta {
  name: Produtos — preço inválido (400)
  type: http
  seq: 23
}

put {
  url: {{baseUrl}}/api/produtos/{{produtoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Câmera Bruno de Teste",
    "descricao": "x",
    "preco": 0,
    "estoque": -1,
    "imagemUrl": null,
    "ativo": true,
    "categoriaId": "{{categoriaId}}"
  }
}

tests {
  test("retorna HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("aponta preço e estoque", function () {
    expect(res.getBody().error.fields).to.include.keys("preco", "estoque");
  });
}
