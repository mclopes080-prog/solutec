meta {
  name: Login válido (salva token)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "pessoa.sprint1@example.test",
    "senha": "Camera@2026"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", res.getBody().data.token);
  }
}

tests {
  test("retorna HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("retorna token JWT e usuário sem hash", function () {
    const data = res.getBody().data;
    expect(data.token.split(".")).to.have.length(3);
    expect(data.usuario.email).to.equal("pessoa.sprint1@example.test");
    expect(data.usuario).not.to.have.property("senhaHash");
  });
}

docs {
  Pré-condição: requisição 02 executada (usuário criado). O script pós-resposta grava o JWT na variável de ambiente `token`, usada pelas próximas requisições autenticadas (Auth → Bearer `{{token}}`).
}
