meta {
  name: Login com senha errada
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "pessoa.sprint1@example.test", "senha": "SenhaErrada@1" }
}

tests {
  test("retorna HTTP 401 genérico", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error.message).to.equal("E-mail ou senha incorretos.");
  });
}

docs {
  Mesma resposta da requisição 11 (e-mail inexistente): a API não revela se o e-mail existe.
}
