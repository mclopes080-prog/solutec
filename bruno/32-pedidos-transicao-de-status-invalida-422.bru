meta {
  name: Pedidos — transição de status inválida (422)
  type: http
  seq: 32
}

put {
  url: {{baseUrl}}/api/pedidos/{{pedidoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "ENVIADO"
  }
}

tests {
  test("retorna HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
  test("explica a regra violada", function () {
    expect(res.getBody().error.code).to.equal("BUSINESS_RULE");
  });
}

docs {
  PENDENTE só pode ir para PAGO ou CANCELADO (tabela REGRAS_STATUS).
}
