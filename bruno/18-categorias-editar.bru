meta {
  name: Categorias — editar
  type: http
  seq: 18
}

put {
  url: {{baseUrl}}/api/categorias/{{categoriaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Categoria Bruno {{sufixo}} (editada)",
    "descricao": "Descrição editada."
  }
}

tests {
  test("retorna HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("aplica a edição", function () {
    expect(res.getBody().data.nome).to.contain("(editada)");
  });
}
