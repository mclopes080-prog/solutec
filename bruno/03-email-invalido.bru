meta {
  name: Cadastro com e-mail inválido
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/api/usuarios/cadastro
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  { "nome": "Pessoa Fictícia", "email": "email-invalido", "senha": "Camera@2026", "cpf": "168.995.350-09" }
}
tests {
  test("retorna HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("identifica o campo e-mail", function () {
    expect(res.getBody().error.code).to.equal("VALIDATION_ERROR");
    expect(res.getBody().error.fields).to.have.property("email");
  });
}
docs {
  Resposta esperada: HTTP 400 com `error.code = VALIDATION_ERROR` e erro associado a `email`.
}
