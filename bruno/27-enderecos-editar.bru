meta {
  name: Endereços — editar
  type: http
  seq: 27
}

put {
  url: {{baseUrl}}/api/enderecos/{{enderecoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "apelido": "Casa (Bruno, editado)",
    "cep": "87250000",
    "logradouro": "Rua Fictícia",
    "numero": "456",
    "complemento": null,
    "bairro": "Centro",
    "cidade": "Peabiru",
    "uf": "PR"
  }
}

tests {
  test("retorna HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("aplica a edição", function () {
    expect(res.getBody().data.numero).to.equal("456");
    expect(res.getBody().data.complemento).to.equal(null);
  });
}
