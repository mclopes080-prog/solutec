meta {
  name: Pedidos — editar itens
  type: http
  seq: 31
}

put {
  url: {{baseUrl}}/api/pedidos/{{pedidoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itens": [
      {
        "produtoId": "{{produtoId}}",
        "quantidade": 3
      }
    ]
  }
}

tests {
  test("retorna HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("recalcula o total", function () {
    const preco = Number(bru.getVar("produtoPreco"));
    expect(res.getBody().data.total).to.equal(Math.round(preco * 3 * 100) / 100);
  });
}
