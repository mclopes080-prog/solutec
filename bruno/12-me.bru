meta {
  name: Meus dados (GET /usuarios/me)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/usuarios/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("retorna HTTP 200 com o próprio usuário", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.usuario.email).to.equal("pessoa.sprint1@example.test");
    expect(res.getBody().data.usuario).not.to.have.property("senhaHash");
  });
}

docs {
  Pré-condição: requisição 09 (token salvo).
}
