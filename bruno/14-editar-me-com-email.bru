meta {
  name: Editar meus dados enviando e-mail (bloqueado)
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/api/usuarios/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Pessoa Fictícia",
    "email": "outro@example.test",
    "cpf": "529.982.247-25",
    "senha": "Camera@2026",
    "confirmacaoSenha": "Camera@2026"
  }
}

tests {
  test("retorna HTTP 400 com mensagem de e-mail imutável", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.message).to.equal("O e-mail não pode ser alterado.");
    expect(res.getBody().error.fields).to.have.property("email");
  });
}
