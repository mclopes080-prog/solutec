meta {
  name: Produtos — editar
  type: http
  seq: 22
}

put {
  url: {{baseUrl}}/api/produtos/{{produtoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Câmera Bruno de Teste",
    "descricao": "Preço e estoque ajustados.",
    "preco": 175,
    "estoque": 8,
    "imagemUrl": "/img/produtos/camera-dome.webp",
    "ativo": true,
    "categoriaId": "{{categoriaId}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("produtoPreco", res.getBody().data.preco);
  }
}

tests {
  test("retorna HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("aplica preço e estoque", function () {
    expect(res.getBody().data.preco).to.equal(175);
    expect(res.getBody().data.estoque).to.equal(8);
  });
}
