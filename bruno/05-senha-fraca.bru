meta {
  name: Cadastro com senha fraca
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/usuarios/cadastro
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  { "nome": "Pessoa Fictícia", "email": "senha.fraca@example.test", "senha": "12345678", "cpf": "168.995.350-09" }
}
tests {
  test("retorna HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("identifica o campo senha", function () { expect(res.getBody().error.fields).to.have.property("senha"); });
}
docs {
  Resposta esperada: HTTP 400 com os critérios obrigatórios descritos no erro de `senha`.
}
