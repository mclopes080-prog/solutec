meta {
  name: Endereços — criar
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/enderecos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "apelido": "Casa (Bruno)",
    "cep": "87250-000",
    "logradouro": "Rua Fictícia",
    "numero": "123",
    "complemento": "Sala 2",
    "bairro": "Centro",
    "cidade": "Peabiru",
    "uf": "pr"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("enderecoId", res.getBody().data.id);
  }
}

tests {
  test("retorna HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("normaliza CEP e UF", function () {
    expect(res.getBody().data.cep).to.equal("87250000");
    expect(res.getBody().data.uf).to.equal("PR");
  });
}

docs {
  O dono vem do token; enviar `usuarioId` no body é rejeitado (schema strict). Salva `enderecoId`.
}
